# Mau cau hinh production. Sao chep thanh deploy/.env.production (khong commit file that).
# Bien nao de trong se dung gia tri mac dinh trong docker-compose.prod.yml.

# --- Bat buoc ---------------------------------------------------------------
SECRET_KEY=
POSTGRES_PASSWORD=
PROCTORING_MEDIA_API_KEY=
PROCTORING_MEDIA_API_SECRET=
PROCTORING_EVIDENCE_S3_ACCESS_KEY_ID=
PROCTORING_EVIDENCE_S3_SECRET_ACCESS_KEY=

# --- May chu / ten mien (doi khi chuyen VPS) ---------------------------------
ALLOWED_HOSTS=khaothi.fermat.vn,khaothi-backend
FRONTEND_BASE_URL=https://khaothi.fermat.vn
PROCTORING_MEDIA_URL=wss://khaothi.fermat.vn
# Nho sua them node_ip trong deploy/livekit.yaml.

# --- Anh vi pham tren Cloudflare R2 -------------------------------------------
PROCTORING_EVIDENCE_STORAGE=s3
PROCTORING_EVIDENCE_S3_BUCKET=exam-education
PROCTORING_EVIDENCE_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
PROCTORING_EVIDENCE_S3_REGION=auto
PROCTORING_EVIDENCE_RETENTION_DAYS=180

# --- Email (BAT BUOC de quen mat khau hoat dong) -------------------------------
# Vi du Gmail: tao "App password" trong tai khoan Google.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@khaothi.fermat.vn

# --- Canh bao su co (healthwatch.sh, backup.sh, update.sh) --------------------
# Telegram: tao bot qua @BotFather, lay chat id bang @userinfobot.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Hoac webhook nhan JSON {"text": "..."} (Slack, Discord /slack, Google Chat...).
ALERT_WEBHOOK_URL=
HEALTHWATCH_DISK_PERCENT=85

# --- Theo doi loi ung dung (tuy chon) ------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
LOG_LEVEL=INFO

# --- Sao luu ------------------------------------------------------------------
BACKUP_DIR=/opt/backups/khaothi
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE_KEEP_DAYS=30
BACKUP_UPLOAD=1
# De trong = dung bucket/khoa R2 cua anh vi pham, thu muc backups/.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=backups

# --- Bao mat ------------------------------------------------------------------
# Gioi han dang nhap: ca phong thi dung chung IP nen gioi han IP de rong.
AUTH_LOGIN_IP_THROTTLE_RATE=300/min
AUTH_LOGIN_ACCOUNT_THROTTLE_RATE=10/min
AUTH_PASSWORD_RESET_IP_THROTTLE_RATE=30/hour
AUTH_PASSWORD_RESET_EMAIL_THROTTLE_RATE=5/hour
# Bat HSTS sau khi chac HTTPS on dinh (vd. 31536000 = 1 nam).
SECURE_HSTS_SECONDS=0

# --- Tai / hieu nang (VPS 4 GB) -----------------------------------------------
WEB_WORKERS=3
CELERY_WORKER_CONCURRENCY=2
POSTGRES_SHARED_BUFFERS=512MB
REDIS_MAXMEMORY=512mb
LIVEKIT_VERSION=v1.13.10
# Do deploy/setup-turn.sh tu dat; khong sua tay.
LIVEKIT_TURN_ENABLED=0

# --- Thi / giam sat -----------------------------------------------------------
EXAM_SUBMISSION_GRACE_SECONDS=300
EXAM_OVERDUE_FINALIZE_INTERVAL_SECONDS=60
PROCTORING_VIOLATION_COOLDOWN_SECONDS=5
PROCTORING_VIOLATION_ESCALATE_AFTER=3
SCHEDULER_HEARTBEAT_MAX_AGE_SECONDS=300

# --- MCP ----------------------------------------------------------------------
EDUEXAM_MCP_MODE=full
